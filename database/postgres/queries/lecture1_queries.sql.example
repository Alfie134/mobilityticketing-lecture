-- Query 1: upcoming trips
select
    t.id,
    t.scheduled_departure_utc,
    t.status
from trips t
where t.route_id = :route_id
  and t.scheduled_departure_utc >= :after_utc
order by t.scheduled_departure_utc
limit 20;

-- Query 2: ordered route stops
-- Show the ordered stops belonging to a route.
select
    rs.stop_sequence,
    s.id as stop_id,
    s.name
from route_stops rs
join stops s on s.id = rs.stop_id
where rs.route_id = :route_id
order by rs.stop_sequence;

-- Query 3: routes and trip count, including routes with zero trips
-- Show all routes and the number of scheduled trips on a supplied
-- service date, including routes with no trips.
-- The service_date filter lives in the JOIN condition, not a WHERE clause,
-- so that a left join preserves routes with zero matching trips instead of
-- being filtered back down to an inner join.
select
    r.id as route_id,
    r.short_name,
    count(t.id) as trip_count
from routes r
left join trips t
    on t.route_id = r.id
    and t.service_date = :service_date
group by r.id, r.short_name
order by r.id;
